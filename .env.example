# InterviewOS environment variables
#
# Copy to .env in the repo root or in api/.

# Optional. Enables Live mode (Claude). If missing, Demo Mode is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# API
DATABASE_URL=sqlite+pysqlite:///./interviewos.db
GUEST_COOKIE_SECRET=change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INTERVIEWOS_AUTH_BYPASS=1

# Postgres (optional; docker compose up)
# DATABASE_URL=postgresql+psycopg://interviewos:interviewos@localhost:5432/interviewos

# Clerk (optional). Without these keys, the web app uses development sign-in.
CLERK_JWKS_URL=
CLERK_ISSUER=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Web
NEXT_PUBLIC_API_URL=
API_ORIGIN=http://127.0.0.1:8000

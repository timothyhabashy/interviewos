# InterviewOS environment variables
#
# Copy this file to .env and fill in real values to enable Live mode.
# If ANTHROPIC_API_KEY is missing or empty, InterviewOS automatically
# runs in Demo Mode using deterministic mock responses (no network calls).

# Your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Override the default Claude model used for interview + scoring.
# If left empty, the app falls back to the DEFAULT_ANTHROPIC_MODEL constant
# defined in app.py.
ANTHROPIC_MODEL=
